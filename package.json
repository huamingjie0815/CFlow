{
  "name": "@hmj-ai/cflow",
  "version": "1.4.0",
  "description": "Local workbench for assembling, inspecting, and running multi-agent workflow graphs",
  "main": "dist/src/server.js",
  "bin": {
    "cflow": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "DESIGN.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "rm -rf dist && pnpm run build:web && pnpm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "tsx --test src/*.test.ts",
    "format": "prettier --write src web README.md README.zh-CN.md DESIGN.md package.json",
    "format:check": "prettier --check src web README.md README.zh-CN.md DESIGN.md package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "workflow",
    "graph",
    "dag",
    "orchestration",
    "acp",
    "local-first",
    "multi-agent"
  ],
  "author": "hmj",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.75.1",
    "@agentclientprotocol/codex-acp": "^1.6.2",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.102.3",
    "@types/node": "^26.2.0",
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.12.1",
    "lucide-react": "^1.34.0",
    "officeparser": "7.8.0",
    "open": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
