{
  "name": "@hmj/cflow",
  "version": "1.0.0",
  "description": "CF Platform 是一个以 **Flow** 为核心维护对象的多 agent 异构编排平台。",
  "main": "dist/src/server.js",
  "bin": {
    "cflow": "dist/src/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "rm -rf dist && pnpm run build:web && pnpm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "tsx --test src/*.test.ts",
    "format": "prettier --write src web README.md design/tech-selection.md",
    "format:check": "prettier --check src web README.md design/tech-selection.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.70.0",
    "@agentclientprotocol/codex-acp": "^1.6.2",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@fastify/static": "^10.1.3",
    "@tanstack/react-query": "^5.102.3",
    "@types/node": "^26.2.0",
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
