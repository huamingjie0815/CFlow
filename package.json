  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test src/*.test.ts",
    "format": "prettier --write src public README.md design/tech-selection.md",
    "format:check": "prettier --check src public README.md design/tech-selection.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
