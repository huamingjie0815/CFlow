{
  "schemaVersion": 1,
  "id": "grok-build",
  "name": "Grok Build",
  "description": "通过项目 manifest 接入本机 Grok Build CLI。",
  "backend": "cli",
  "command": "grok",
  "args": ["--single", "--verbatim", "--output-format", "plain"],
  "versionArgs": ["--version"],
  "promptTransport": "argument",
  "outputMode": "json",
  "envAllowlist": ["HOME", "PATH", "LANG", "LC_ALL", "XAI_API_KEY", "GROK_SANDBOX"],
  "capabilities": [
    "reasoning",
    "code",
    "structured-output",
    "workspace-read",
    "workspace-write",
    "command"
  ],
  "permissionArgs": {
    "none": ["--disable-web-search", "--permission-mode", "plan"],
    "read": ["--disable-web-search", "--permission-mode", "plan"],
    "write": ["--disable-web-search", "--permission-mode", "acceptEdits"],
    "full": ["--disable-web-search", "--permission-mode", "auto"]
  }
}
